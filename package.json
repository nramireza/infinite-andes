{
  "name": "infinite-andes",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Paisaje procedural infinito de los Andes chilenos en pixel art.",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "start:python": "python3 -m http.server 8000",
    "test": "node --test test/",
    "check": "for f in src/*.js; do node --check \"$f\" || exit 1; done",
    "palette": "node scripts/palette-table.mjs > docs/14-paleta-maestra.md",
    "species": "node scripts/species.mjs",
    "bench": "node scripts/bench.mjs",
    "shots": "bash scripts/capture.sh"
  }
}
